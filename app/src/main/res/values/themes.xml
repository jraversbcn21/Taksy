<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ticksy" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Colores del gradiente del icono -->
        <item name="colorPrimary">@color/icon_green</item>
        <item name="colorPrimaryDark">@color/icon_dark_green</item>
        <item name="colorAccent">@color/icon_teal</item>
        <item name="android:statusBarColor">@color/icon_dark_teal</item>
        <item name="android:navigationBarColor">@color/icon_green</item>
        
        <!-- Colores para modo claro -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>
    </style>

    <style name="Theme.Ticksy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ticksy_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Ticksy</item>
    </style>
</resources>